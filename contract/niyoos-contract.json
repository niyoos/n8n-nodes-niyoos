  "clientHeader": {
    "name": "x-niyoos-client",
    "value": "n8n"
  },
  "runContext": {
    "runIdHeader": "x-niyoos-run-id",
    "stepHeader": "x-niyoos-step",
    "parentRunIdHeader": "x-niyoos-parent-run-id",
    "runIdPattern": "^[A-Za-z0-9_-]{8,64}$"
  }
